# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/vcpautomation
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vcpautomation
DB_USER=username
DB_PASSWORD=password

# JWT Secret (use a long random string in production — never commit real values)
JWT_SECRET=change-me-to-a-long-random-secret

# Optional admin secret for set-password endpoint
ADMIN_SECRET=change-me-admin-secret

# GitLab API Configuration (optional)
GITLAB_TOKEN=
GITLAB_URL=
GITLAB_PROJECT_ID=

# GitHub API Configuration (optional)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Optional SMTP email (nodemailer) — used for recruitment/notifications only
# Login uses email + password; magic-link / Resend is not used.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=admin@example.com

# Frontend URL
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:3001

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
